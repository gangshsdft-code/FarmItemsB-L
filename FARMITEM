local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer

local WorldItems = workspace:WaitForChild("WorldItems")

if WorldItems:GetAttribute("FindItemExecuted") ~= nil then
	return
else
	WorldItems:SetAttribute("FindItemExecuted", true)
end

local Spawn = WorldItems:WaitForChild("Spawn")
local Temp = WorldItems:WaitForChild("Temp")

local ShouldStayInServer = false

local Timer = 5
local CurrentTimer = Timer
local Items = {"Pale Key"}

queueteleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

task.spawn(function()
	while task.wait(1) do
		if CurrentTimer <= 0 and ShouldStayInServer == false then
			if #Players:GetChildren() <= 1 then
				LocalPlayer:Kick("\nRejoining...")
				task.wait(0.3)
				TeleportService:Teleport(game.PlaceId, LocalPlayer, nil)
			else
				LocalPlayer:Kick("Server is not refreshable.")
			end
			break
		end
		CurrentTimer -= 1
	end
end)

local function StayInServer()
	ShouldStayInServer = true
	local RingSound = Instance.new("Sound",game.CoreGui)
	RingSound.SoundId = "rbxassetid://2783281207"
	RingSound.Volume = 5
	RingSound:Play()
end

local function FindItems()
	for _, Item in pairs(Spawn:GetChildren()) do
		for _, DesiredItem in pairs(Items) do
			if Item.Name == DesiredItem then
				StayInServer()
				break
			end
		end
	end
end

local function ResetTimer()
	if ShouldStayInServer == true then
		return
	end
	print("Reset timer.")
	FindItems()
	CurrentTimer = Timer
end

local function InitializePlayer()
	FindItems()
	local PlayerGui = LocalPlayer.PlayerGui
	local Menu = PlayerGui:WaitForChild("TeamSelect_Menu")
	local MainMusic = Menu.LocalScript.Music.Music_Main
	MainMusic.Playing = false
	MainMusic:GetPropertyChangedSignal("Playing"):Connect(function()
		if MainMusic.Playing ~= false then
			MainMusic.Playing = false
		end
	end)
end

Temp.ChildAdded:Connect(function(NewInstance)
	if NewInstance:IsA("Configuration") and ShouldStayInServer == false then
		for _, Item in pairs(Items) do
			if NewInstance.Name == Item then
				StayInServer()
				return
			end
		end
		ResetTimer()
	end
end)

LocalPlayer.OnTeleport:Connect(function()
	if queueteleport then
		queueteleport('loadstring(game:HttpGet("https://raw.githubusercontent.com/gangshsdft-code/FarmItemsB-L/main/FARMITEM"))()')
	end
end)

InitializePlayer()
